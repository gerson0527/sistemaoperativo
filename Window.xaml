<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nexo Assistant" Width="1140" Height="770" MinWidth="760" MinHeight="500" Background="#F5F6F3" FontFamily="Segoe UI" FontSize="15" WindowStartupLocation="CenterScreen">
  <Window.Resources>


    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#263C39"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>


    <Style TargetType="CheckBox">
      <Setter Property="Padding" Value="6,1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Margin" Value="8,9"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>


    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#193F38"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#C2D1CA"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Margin" Value="0,0,8,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#178570"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value=".48"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>


  </Window.Resources>
  <Grid x:Name="Design" Background="#F5F6F3">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="202"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Background="#112E2B" Padding="20,25,16,20">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal">
            <Path Width="28" Height="28" Stretch="Fill" Fill="#A8E8BA" Data="M0,28 L0,0 7,0 20,16 20,0 28,0 28,28 21,28 8,12 8,28 Z"/>
            <TextBlock Text="Nexo" FontSize="25" FontWeight="SemiBold" Foreground="White" Margin="10,-4,0,0"/>
          </StackPanel>
          <Border Height="1" Background="#35514D" Margin="0,22,0,20"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <StackPanel x:Name="HardwareFooter" Margin="0,0,0,12">
            <TextBlock Text="" x:Name="BoardText" FontSize="12" Foreground="#BBD1CB" Margin="0,0,0,3"/>
            <TextBlock Text="" x:Name="RAMText" FontSize="12" Foreground="#BBD1CB" Margin="0,0,0,3"/>
            <TextBlock Text="" x:Name="CPUText" FontSize="12" Foreground="#BBD1CB" Margin="0,0,0,3"/>
          </StackPanel>
          <Button x:Name="OpenEngine" Content="Herramientas"/>
          <Button x:Name="OpenDelta" Content="DELTA Pro"/>
        </StackPanel>
        <StackPanel>
          <Border x:Name="Stage0" CornerRadius="5" Padding="10,9" Margin="0,0,0,3">
            <TextBlock x:Name="StageLabel0" Text="Introducción" Foreground="#D4E3DD"/>
          </Border>
          <Border x:Name="Stage1" CornerRadius="5" Padding="10,9" Margin="0,0,0,3">
            <TextBlock x:Name="StageLabel1" Text="Equipo" Foreground="#D4E3DD"/>
          </Border>
          <Border x:Name="Stage2" CornerRadius="5" Padding="10,9" Margin="0,0,0,3">
            <TextBlock x:Name="StageLabel2" Text="Programas" Foreground="#D4E3DD"/>
          </Border>
          <Border x:Name="Stage3" CornerRadius="5" Padding="10,9" Margin="0,0,0,3">
            <TextBlock x:Name="StageLabel3" Text="Personalización" Foreground="#D4E3DD"/>
          </Border>
          <Border x:Name="Stage4" CornerRadius="5" Padding="10,9" Margin="0,0,0,3">
            <TextBlock x:Name="StageLabel4" Text="Revisión" Foreground="#D4E3DD"/>
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="30,22,30,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,16">
        <TextBlock x:Name="StepCounter" DockPanel.Dock="Right" FontSize="13" Foreground="#536761"/>
        <TextBlock Text="Configuración de Windows" FontWeight="SemiBold"/>
      </DockPanel>
      <Grid Grid.Row="1">
        <ScrollViewer x:Name="PageTerms" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,10,8">
            <Border Height="105" CornerRadius="8" Background="#19483F" ClipToBounds="True" Margin="0,0,0,18">
  <Grid ClipToBounds="True">
    <Canvas Width="330" HorizontalAlignment="Right" IsHitTestVisible="False">
      <Path Data="M 0,125 L 120,-20 L 172,-20 L 52,125 Z" Fill="#245C4F"/>
      <Path Data="M 92,125 L 212,-20 L 266,-20 L 146,125 Z" Fill="#357962"/>
      <Path Data="M 186,125 L 306,-20 L 360,-20 L 240,125 Z" Fill="#79B79A"/>
    </Canvas>
    <StackPanel Margin="20,0" VerticalAlignment="Center" HorizontalAlignment="Left">
      <TextBlock Text="Nexo Assistant" Foreground="White" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="Instalación y personalización" Foreground="#CAE3D4" FontSize="14"/>
    </StackPanel>
  </Grid>
</Border>
<TextBlock Text="Antes de comenzar" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Elige qué instalar y qué ajustes aplicar en este equipo." Foreground="#485D56" Margin="0,0,0,12"/>
            <Border Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Cómo se aplican los cambios" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/>
                <TextBlock Text="Al finalizar podrás revisar y confirmar cada acción. Nexo registra el resultado de las instalaciones y los ajustes." Foreground="#485D56" Margin="0,0,0,12"/>
              </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Qué necesitas" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/>
                <TextBlock Text="Conexión a Internet para las descargas y una licencia válida para Office o para cambiar la edición de Windows. Guarda tu trabajo antes de aplicar el plan." Foreground="#485D56" Margin="0,0,0,12"/>
              </StackPanel>
            </Border>
            <WrapPanel>
              <Button x:Name="Accept" Content="Aceptar y continuar" Background="#176452" Foreground="White" BorderBrush="#176452"/>
              <Button x:Name="Decline" Content="Salir"/>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="PageWelcome" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,10,8">
            <TextBlock Text="Prepara tu equipo" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Configura el almacenamiento antes de elegir los componentes." Foreground="#485D56" Margin="0,0,0,12"/>
            <Border Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Espacio en disco" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/>
                <TextBlock Text="CompactOS comprime los archivos de Windows para liberar espacio. La operación puede tardar varios minutos." Foreground="#485D56" Margin="0,0,0,12"/>
                <CheckBox x:Name="Compression" Content="Incluir compresión de Windows"/>
              </StackPanel>
            </Border>
            <Button x:Name="WelcomeNext" Content="Continuar" Background="#176452" Foreground="White" BorderBrush="#176452" HorizontalAlignment="Left"/>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="PageMigration" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,10,8">
            <TextBlock Text="Edición de Windows" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Elige una edición si tienes su clave o conserva la actual." Foreground="#485D56" Margin="0,0,0,12"/>
            <Border x:Name="Migration0Card" Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,8">
              <DockPanel>
                <Button x:Name="Migration0" Content="Seleccionar" DockPanel.Dock="Right" VerticalAlignment="Center" Tag="Migration|Professional"/>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="Pro" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/>
                  <TextBlock Text="Para equipos de uso profesional" Foreground="#485D56"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border x:Name="Migration1Card" Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,8">
              <DockPanel>
                <Button x:Name="Migration1" Content="Seleccionar" DockPanel.Dock="Right" VerticalAlignment="Center" Tag="Migration|Enterprise"/>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="Enterprise" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/>
                  <TextBlock Text="Para entornos administrados" Foreground="#485D56"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border x:Name="Migration2Card" Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,8">
              <DockPanel>
                <Button x:Name="Migration2" Content="Seleccionar" DockPanel.Dock="Right" VerticalAlignment="Center" Tag="Migration|Workstation"/>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="Pro para estaciones de trabajo" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/>
                  <TextBlock Text="Para estaciones de trabajo compatibles" Foreground="#485D56"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Button x:Name="SkipMigration" Content="Omitir este paso" HorizontalAlignment="Left"/>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="PageGpu" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,10,8">
            <TextBlock Text="Controlador gráfico" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Selecciona el fabricante de tu GPU para buscar un controlador compatible." Foreground="#485D56" Margin="0,0,0,12"/>
            <Border x:Name="Gpu0Card" Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,8">
              <DockPanel>
                <Button x:Name="Gpu0" Content="Seleccionar" DockPanel.Dock="Right" VerticalAlignment="Center" Tag="Gpu|INTEL"/>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="Intel" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/>
                  <TextBlock Text="Gráficos Intel" Foreground="#485D56"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border x:Name="Gpu1Card" Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,8">
              <DockPanel>
                <Button x:Name="Gpu1" Content="Seleccionar" DockPanel.Dock="Right" VerticalAlignment="Center" Tag="Gpu|NVIDIA"/>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="NVIDIA" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/>
                  <TextBlock Text="GeForce y otras GPU NVIDIA" Foreground="#485D56"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border x:Name="Gpu2Card" Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,8">
              <DockPanel>
                <Button x:Name="Gpu2" Content="Seleccionar" DockPanel.Dock="Right" VerticalAlignment="Center" Tag="Gpu|AMD"/>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="AMD" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/>
                  <TextBlock Text="Radeon y otras GPU AMD" Foreground="#485D56"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Button x:Name="SkipGpu" Content="Omitir este paso" HorizontalAlignment="Left"/>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="PageDisk" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,10,8">
            <TextBlock Text="Unidad del sistema" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Windows optimiza la unidad según su tecnología." Foreground="#485D56" Margin="0,0,0,12"/>
            <Border x:Name="Disk0Card" Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,8">
              <DockPanel>
                <Button x:Name="Disk0" Content="Seleccionar" DockPanel.Dock="Right" VerticalAlignment="Center" Tag="Disk|SSD / M.2"/>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="SSD o M.2" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/>
                  <TextBlock Text="Aplicar la optimización de Windows para estado sólido" Foreground="#485D56"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border x:Name="Disk1Card" Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,8">
              <DockPanel>
                <Button x:Name="Disk1" Content="Seleccionar" DockPanel.Dock="Right" VerticalAlignment="Center" Tag="Disk|HDD"/>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="Disco mecánico" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/>
                  <TextBlock Text="Aplicar la optimización de Windows para disco mecánico" Foreground="#485D56"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="PageDevice" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,10,8">
            <TextBlock Text="Tipo de equipo" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Elige el formato de este equipo para preparar su configuración de energía." Foreground="#485D56" Margin="0,0,0,12"/>
            <Border x:Name="Device0Card" Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,8">
              <DockPanel>
                <Button x:Name="Device0" Content="Seleccionar" DockPanel.Dock="Right" VerticalAlignment="Center" Tag="Device|Desktop"/>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="Equipo de escritorio" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/>
                  <TextBlock Text="Opciones de energía para sobremesa" Foreground="#485D56"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border x:Name="Device1Card" Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,8">
              <DockPanel>
                <Button x:Name="Device1" Content="Seleccionar" DockPanel.Dock="Right" VerticalAlignment="Center" Tag="Device|Laptop"/>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="Portátil" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/>
                  <TextBlock Text="Opciones de energía para batería" Foreground="#485D56"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="PageOffice" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,10,8">
            <TextBlock Text="Aplicaciones de Office" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Marca las aplicaciones que quieres instalar con tu licencia." Foreground="#485D56" Margin="0,0,0,12"/>
            <UniformGrid Columns="2">
              <Border x:Name="OfficeCardWord" Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="5" Margin="0,0,7,7">
                <CheckBox x:Name="OfficeWord">
                  <TextBlock x:Name="OfficeLabelWord" Text="Word"/>
                </CheckBox>
              </Border>
              <Border x:Name="OfficeCardExcel" Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="5" Margin="0,0,7,7">
                <CheckBox x:Name="OfficeExcel">
                  <TextBlock x:Name="OfficeLabelExcel" Text="Excel"/>
                </CheckBox>
              </Border>
              <Border x:Name="OfficeCardPowerPoint" Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="5" Margin="0,0,7,7">
                <CheckBox x:Name="OfficePowerPoint">
                  <TextBlock x:Name="OfficeLabelPowerPoint" Text="PowerPoint"/>
                </CheckBox>
              </Border>
              <Border x:Name="OfficeCardOutlook" Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="5" Margin="0,0,7,7">
                <CheckBox x:Name="OfficeOutlook">
                  <TextBlock x:Name="OfficeLabelOutlook" Text="Outlook"/>
                </CheckBox>
              </Border>
              <Border x:Name="OfficeCardAccess" Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="5" Margin="0,0,7,7">
                <CheckBox x:Name="OfficeAccess">
                  <TextBlock x:Name="OfficeLabelAccess" Text="Access"/>
                </CheckBox>
              </Border>
              <Border x:Name="OfficeCardVisio" Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="5" Margin="0,0,7,7">
                <CheckBox x:Name="OfficeVisio">
                  <TextBlock x:Name="OfficeLabelVisio" Text="Visio"/>
                </CheckBox>
              </Border>
              <Border x:Name="OfficeCardPublisher" Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="5" Margin="0,0,7,7">
                <CheckBox x:Name="OfficePublisher">
                  <TextBlock x:Name="OfficeLabelPublisher" Text="Publisher"/>
                </CheckBox>
              </Border>
              <Border x:Name="OfficeCardOneNote" Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="5" Margin="0,0,7,7">
                <CheckBox x:Name="OfficeOneNote">
                  <TextBlock x:Name="OfficeLabelOneNote" Text="OneNote"/>
                </CheckBox>
              </Border>
            </UniformGrid>
            <TextBlock Text="" x:Name="OfficeCount" Margin="0,6,0,12"/>
            <WrapPanel>
              <Button x:Name="OfficeNext" Content="Continuar" Background="#176452" Foreground="White" BorderBrush="#176452"/>
              <Button x:Name="OfficeSkip" Content="Omitir Office"/>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="PageApps" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,10,8">
            <TextBlock Text="Programas y bibliotecas" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Selecciona los componentes que quieras añadir a Windows." Foreground="#485D56" Margin="0,0,0,12"/>
            <Border Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,0,0,12">
              <StackPanel>
                <UniformGrid Columns="2">
                  <CheckBox x:Name="App0_0" Content="Framework"/>
                  <CheckBox x:Name="App0_1" Content=".NET 8"/>
                  <CheckBox x:Name="App0_2" Content="VCredist"/>
                  <CheckBox x:Name="App0_3" Content="DirectX"/>
                  <CheckBox x:Name="App0_4" Content="MSI Afterburner"/>
                  <CheckBox x:Name="App1_0" Content="Free Download Man."/>
                  <CheckBox x:Name="App1_1" Content="Google Chrome"/>
                  <CheckBox x:Name="App1_2" Content="Mozilla Firefox"/>
                  <CheckBox x:Name="App1_3" Content="Opera"/>
                  <CheckBox x:Name="App1_4" Content="Brave"/>
                  <CheckBox x:Name="App2_0" Content="AIMP"/>
                  <CheckBox x:Name="App2_1" Content="PotPlayer"/>
                  <CheckBox x:Name="App2_2" Content="VLC"/>
                  <CheckBox x:Name="App2_3" Content="K-Lite Codec"/>
                  <CheckBox x:Name="App3_0" Content="7 Zip"/>
                  <CheckBox x:Name="App3_1" Content="WinRAR"/>
                  <CheckBox x:Name="App3_2" Content="Greenshot"/>
                  <CheckBox x:Name="App3_3" Content="HWiNFO"/>
                  <CheckBox x:Name="App3_4" Content="Menú Nexo"/>
                  <CheckBox x:Name="App3_5" Content="Java v8 Update"/>
                </UniformGrid>
              </StackPanel>
            </Border>
            <TextBlock Text="" x:Name="AppCount" Margin="0,0,0,8"/>
            <Button x:Name="AppsNext" Content="Continuar" Background="#176452" Foreground="White" BorderBrush="#176452" HorizontalAlignment="Left"/>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="PageCustom" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,10,8">
            <TextBlock Text="Escritorio" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Combina un fondo, iconos y paneles o elige un tema." Foreground="#485D56" Margin="0,0,0,12"/>
            <Border Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,0,0,12">
              <StackPanel>
                <Rectangle x:Name="DesktopPreview" Height="95" RadiusX="5" RadiusY="5" Margin="0,0,0,12"/>
                <WrapPanel>
                  <Button x:Name="ThemeNEXO" Content="NEXO"/>
                  <Button x:Name="ThemeXP" Content="XP"/>
                  <Button x:Name="ThemeSEVEN" Content="SEVEN"/>
                  <Button x:Name="ThemeNEON" Content="NEON"/>
                  <Button x:Name="ThemeBASIC" Content="BASIC"/>
                  <Button x:Name="ThemeMAC" Content="MAC"/>
                </WrapPanel>
                <WrapPanel>
                  <Button x:Name="RandomTheme" Content="Tema aleatorio"/>
                  <Button x:Name="ResetTheme" Content="Restablecer"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <WrapPanel>
              <StackPanel Width="165" Margin="0,0,10,9">
                <TextBlock Text="Fondo"/>
                <ComboBox x:Name="Wallpaper" SelectedIndex="0" Padding="5">
                  <ComboBoxItem Content="Wallpaper Hojas"/>
                  <ComboBoxItem Content="Wallpaper Neon"/>
                  <ComboBoxItem Content="Wallpaper Ice"/>
                  <ComboBoxItem Content="Wallpaper Nexo"/>
                  <ComboBoxItem Content="Default"/>
                </ComboBox>
              </StackPanel>
              <StackPanel Width="165" Margin="0,0,10,9">
                <TextBlock Text="Widgets"/>
                <ComboBox x:Name="Rainmeter" SelectedIndex="0" Padding="5">
                  <ComboBoxItem Content="Skin Neon"/>
                  <ComboBoxItem Content="Ninguno"/>
                  <ComboBoxItem Content="Skin Canopy"/>
                  <ComboBoxItem Content="Skin NeonBasic"/>
                  <ComboBoxItem Content="Skin Round"/>
                </ComboBox>
              </StackPanel>
              <StackPanel Width="165" Margin="0,0,10,9">
                <TextBlock Text="Iconos"/>
                <ComboBox x:Name="Icons" SelectedIndex="0" Padding="5">
                  <ComboBoxItem Content="Icons Vivid"/>
                  <ComboBoxItem Content="Default"/>
                  <ComboBoxItem Content="Icons Windows12"/>
                  <ComboBoxItem Content="Icons Numix"/>
                </ComboBox>
              </StackPanel>
              <StackPanel Width="165" Margin="0,0,10,9">
                <TextBlock Text="Inicio"/>
                <ComboBox x:Name="StartMenu" SelectedIndex="0" Padding="5">
                  <ComboBoxItem Content="Inicio Launch"/>
                  <ComboBoxItem Content="Default"/>
                  <ComboBoxItem Content="Inicio Win7"/>
                  <ComboBoxItem Content="Inicio Win11"/>
                </ComboBox>
              </StackPanel>
              <StackPanel Width="165" Margin="0,0,10,9">
                <TextBlock Text="Dock"/>
                <ComboBox x:Name="Dock" SelectedIndex="0" Padding="5">
                  <ComboBoxItem Content="Dock Neon"/>
                  <ComboBoxItem Content="Default"/>
                  <ComboBoxItem Content="Dock Fluent"/>
                  <ComboBoxItem Content="Dock MAC"/>
                </ComboBox>
              </StackPanel>
            </WrapPanel>
            <WrapPanel>
              <CheckBox x:Name="MenuTranslucent" Content="Transparencia del menú"/>
              <CheckBox x:Name="ExplorerTranslucent" Content="Transparencia del explorador"/>
            </WrapPanel>
            <Button x:Name="CustomNext" Content="Incluir escritorio y continuar" Background="#176452" Foreground="White" BorderBrush="#176452" HorizontalAlignment="Left"/>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="PageMode" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,10,8">
            <TextBlock Text="Perfil de ajustes" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Elige los cambios que quieres incluir en el plan." Foreground="#485D56" Margin="0,0,0,12"/>
            <Border x:Name="Mode0Card" Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,8">
              <DockPanel>
                <Button x:Name="Mode0" Content="Seleccionar" DockPanel.Dock="Right" VerticalAlignment="Center" Tag="Mode|Seguro"/>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="Seguro" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/>
                  <TextBlock Text="Mostrar extensiones y usar el plan equilibrado" Foreground="#485D56"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border x:Name="Mode1Card" Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,8">
              <DockPanel>
                <Button x:Name="Mode1" Content="Seleccionar" DockPanel.Dock="Right" VerticalAlignment="Center" Tag="Mode|Medio"/>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="Medio" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/>
                  <TextBlock Text="Añadir reducción de transparencias y sugerencias" Foreground="#485D56"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border x:Name="Mode2Card" Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,8">
              <DockPanel>
                <Button x:Name="Mode2" Content="Seleccionar" DockPanel.Dock="Right" VerticalAlignment="Center" Tag="Mode|Extremo"/>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="Juegos" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/>
                  <TextBlock Text="Añadir la desactivación de la grabación de juegos" Foreground="#485D56"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="PageDebloat" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,10,8">
            <TextBlock Text="Aplicaciones preinstaladas" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Marca únicamente las aplicaciones que quieras quitar de tu usuario." Foreground="#485D56" Margin="0,0,0,12"/>
            <Border Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,0,0,12">
              <StackPanel>
                <UniformGrid Columns="2">
                  <CheckBox x:Name="Debloat0" Content="Quitar Noticias"/>
                  <CheckBox x:Name="Debloat1" Content="Quitar Comentarios"/>
                  <CheckBox x:Name="Debloat2" Content="Quitar Primeros Pasos"/>
                  <CheckBox x:Name="Debloat3" Content="Quitar Cámara"/>
                  <CheckBox x:Name="Debloat4" Content="Quitar MS Teams"/>
                  <CheckBox x:Name="Debloat5" Content="Quitar Tu Teléfono"/>
                  <CheckBox x:Name="Debloat6" Content="Quitar Obtener Ayuda"/>
                  <CheckBox x:Name="Debloat7" Content="Quitar Contactos"/>
                  <CheckBox x:Name="Debloat8" Content="Quitar Mapas"/>
                  <CheckBox x:Name="Debloat9" Content="Quitar Skype"/>
                  <CheckBox x:Name="Debloat10" Content="Quitar OneNote"/>
                  <CheckBox x:Name="Debloat11" Content="Quitar Correo y Calendario"/>
                  <CheckBox x:Name="Debloat12" Content="Quitar MS Designer"/>
                  <CheckBox x:Name="Debloat13" Content="Quitar Clipchamp"/>
                  <CheckBox x:Name="Debloat14" Content="Quitar Rep. Multimedia"/>
                  <CheckBox x:Name="Debloat15" Content="Quitar Office Hub"/>
                  <CheckBox x:Name="Debloat16" Content="Quitar Paint 3D"/>
                  <CheckBox x:Name="Debloat17" Content="Quitar Realidad Mixta"/>
                  <CheckBox x:Name="Debloat18" Content="Quitar Clima y Tiempo"/>
                  <CheckBox x:Name="Debloat19" Content="Quitar MS To Do"/>
                  <CheckBox x:Name="Debloat20" Content="Quitar Solitario"/>
                  <CheckBox x:Name="Debloat21" Content="Quitar Películas y TV"/>
                  <CheckBox x:Name="Debloat22" Content="Quitar Visor 3D"/>
                </UniformGrid>
              </StackPanel>
            </Border>
            <TextBlock Text="" x:Name="DebloatCount" Margin="0,0,0,8"/>
            <Button x:Name="DebloatNext" Content="Continuar" Background="#176452" Foreground="White" BorderBrush="#176452" HorizontalAlignment="Left"/>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="PageReview" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,10,8">
            <TextBlock Text="Revisa tu selección" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Comprueba las acciones antes de abrir el motor de instalación." Foreground="#485D56" Margin="0,0,0,12"/>
            <Border Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Acciones elegidas" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/>
                <TextBlock Text="" x:Name="AvailableSummary"/>
              </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Estado de las opciones" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/>
                <TextBlock Text="" x:Name="PendingSummary"/>
              </StackPanel>
            </Border>
            <WrapPanel>
              <Button x:Name="ReviewFinish" Content="Finalizar" Background="#176452" Foreground="White" BorderBrush="#176452"/>
              <Button x:Name="ReviewEngine" Content="Revisar acciones"/>
              <Button x:Name="SaveSelection" Content="Guardar selección"/>
              <Button x:Name="PreviewProcess" Content="Ver proceso"/>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="PageProcess" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,10,8">
            <TextBlock Text="Vista previa del proceso" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Consulta los datos del equipo donde se aplicará el plan." Foreground="#485D56" Margin="0,0,0,12"/>
            <Border Background="White" BorderBrush="#D6DED8" BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Windows" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/>
                <TextBlock Text="" x:Name="ProcessOS" Margin="0,0,0,12"/>
                <TextBlock Text="Equipo" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/>
                <TextBlock Text="" x:Name="ProcessBoard" Margin="0,0,0,12"/>
                <TextBlock Text="Procesador" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/>
                <TextBlock Text="" x:Name="ProcessProcessor" Margin="0,0,0,12"/>
                <TextBlock Text="Memoria" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/>
                <TextBlock Text="" x:Name="ProcessMemory" Margin="0,0,0,12"/>
                <TextBlock Text="Unidad" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/>
                <TextBlock Text="" x:Name="ProcessDrive" Margin="0,0,0,12"/>
              </StackPanel>
            </Border>
            <Button x:Name="ProcessFinish" Content="Continuar" Background="#176452" Foreground="White" BorderBrush="#176452" HorizontalAlignment="Left"/>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="PageFinish" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,10,8">
            <TextBlock Text="Selección guardada" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Puedes volver a abrir Nexo para recuperar tus preferencias." Foreground="#485D56" Margin="0,0,0,12"/>
            <WrapPanel>
              <Button x:Name="FinishExit" Content="Salir" Background="#176452" Foreground="White" BorderBrush="#176452"/>
              <Button x:Name="About" Content="Acerca de Nexo"/>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <DockPanel Grid.Row="2" Margin="0,10,0,0">
        <Button x:Name="Back" Content="‹  Volver" DockPanel.Dock="Left"/>
        <TextBlock Text="" x:Name="Status" FontSize="12" Foreground="#51665E" VerticalAlignment="Center"/>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
